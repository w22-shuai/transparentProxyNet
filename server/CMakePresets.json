{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "WSL",
      "description": "WSL",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${sourceDirName}",
      "installDir": "${sourceDir}/install/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "/home/download/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL"
        }
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "WSL",
      "description": "WSL",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}